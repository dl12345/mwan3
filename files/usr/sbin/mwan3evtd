#!/usr/bin/env ucode
// SPDX-License-Identifier: GPL-2.0
//
// mwan3evtd - Event Coalescing Daemon
//
// Coalesces system events pushed over ubus so a registered handler
// runs at most once per coalescing window.  See the design document
// for rationale.

'use strict';

import * as libubus from 'ubus';
import * as uloop from 'uloop';
import * as libuci from 'uci';
import { openlog, syslog, LOG_PID, LOG_DAEMON, LOG_INFO, LOG_WARNING, LOG_ERR } from 'log';

const CONFIG_FILE = 'mwan3evtd';
const DEFAULT_WINDOW_MS = 500;
const DEFAULT_MAX_WINDOW_MS = 5000;
const DEFAULT_HANDLER_TIMEOUT_MS = 30000;
const SIGKILL_DELAY_MS = 5000;
const KILL_CMD_TIMEOUT_MS = 500;
const EVENT_NAME_RE = /^[A-Za-z0-9_.:-]{1,64}$/;
// libubox timer arithmetic is 32-bit signed ms; cap well below the ~2.1B ms overflow point.
const MAX_TIMER_MS = 3600000;

openlog('mwan3evtd', LOG_PID, LOG_DAEMON);

function log_info(fmt, ...args) { syslog(LOG_INFO, fmt, ...args); }
function log_warn(fmt, ...args) { syslog(LOG_WARNING, fmt, ...args); }
function log_err(fmt, ...args)  { syslog(LOG_ERR, fmt, ...args); }

// Monotonic millisecond clock for timing measurements.
// clock() returns [seconds, nanoseconds]; clock(true) = CLOCK_MONOTONIC.

function now_ms() { let t = clock(true); return t[0] * 1000 + int(t[1] / 1000000); }

// handlers: { name -> { command, window_ms, max_window_ms, handler_timeout_ms,
//                       supersedes: [names], superseded_by: [names] } }

let handlers = {};

// events: { name -> { state, window_timer, deadline_timer, command_snapshot,
//                     handler_proc, handler_pid, handler_timeout_timer,
//                     handler_kill_timer, pending_after, pending_after_pushes,
//                     batch_start_ms, batch_last_push_ms, batch_pushes,
//                     last_fired_at_ms, last_batch_duration_ms, last_batch_pushes,
//                     counters } }
// state: 'idle' | 'pending' | 'running'

let events = {};

// Forward declaration: fire_handler and start_pending mutually reference each other
// via closures.  Ucode strict-mode captures the scope chain at function-definition
// time, so a plain 'function foo()' declared after start_pending would not be
// visible inside start_pending's timer callbacks.  Declaring the binding here
// before either function is defined, then assigning below, keeps both names in scope.

let fire_handler;

function ensure_event(name) {
	if (!events[name]) {
		events[name] = {
			state: 'idle',
			pending_after: false,
			pending_after_pushes: 0,
			batch_start_ms: 0,
			batch_last_push_ms: 0,
			batch_pushes: 0,
			last_fired_at_ms: 0,
			last_batch_duration_ms: 0,
			last_batch_pushes: 0,
			counters: {
				pushes: 0,
				invocations: 0,
				superseded_as_source: 0,
				superseded_as_target: 0,
				after_running_coalesced: 0,
				failures: 0,
				timeouts: 0,
				window_resets: 0,
				deadline_fires: 0,
				max_inter_push_ms: 0,
			},
		};
	}
	return events[name];
}

function cancel_coalescing_timers(ev) {
	if (ev.window_timer) { ev.window_timer.cancel(); delete ev.window_timer; }
	if (ev.deadline_timer) { ev.deadline_timer.cancel(); delete ev.deadline_timer; }
}

function clear_handler_timers(ev) {
	if (ev.handler_timeout_timer) { ev.handler_timeout_timer.cancel(); delete ev.handler_timeout_timer; }
	if (ev.handler_kill_timer)    { ev.handler_kill_timer.cancel();    delete ev.handler_kill_timer; }
}

// Coerce a UCI string value to a positive integer in [1, MAX_TIMER_MS].
// Returns def for zero, negative, non-numeric, or missing values.

function clamp_ms(v, def) {
	let n = int(v);
	if (n == null || n < 1)
		return def;
	return n > MAX_TIMER_MS ? MAX_TIMER_MS : n;
}

function to_list(v) {
	if (type(v) == 'array')
		return v;
	if (v === null || v === undefined)
		return [];
	return [ v ];
}

function load_config() {
	let new_handlers = {};
	let ctx = libuci.cursor();
	ctx.load(CONFIG_FILE);
	ctx.foreach(CONFIG_FILE, 'handler', (s) => {

		let name = s.event;

		if (type(name) != 'string' || !match(name, EVENT_NAME_RE)) {
			log_warn("skipping section '%s': invalid or missing 'event'", s['.name'] ?? '?');
			return;
		}
		if (type(s.command) != 'string' || length(s.command) == 0) {
			log_warn("skipping handler '%s': missing 'command'", name);
			return;
		}
		if (new_handlers[name]) {
			log_warn("duplicate handler for event '%s'; keeping first", name);
			return;
		}

		let window_ms          = clamp_ms(s.window_ms,          DEFAULT_WINDOW_MS);
		let max_window_ms      = clamp_ms(s.max_window_ms,      DEFAULT_MAX_WINDOW_MS);
		let handler_timeout_ms = clamp_ms(s.handler_timeout_ms, DEFAULT_HANDLER_TIMEOUT_MS);

		if (window_ms > max_window_ms)
			log_warn("handler '%s': window_ms (%d) > max_window_ms (%d); deadline will fire first",
				name, window_ms, max_window_ms);

		new_handlers[name] = {
			command: s.command,
			window_ms,
			max_window_ms,
			handler_timeout_ms,
			supersedes: to_list(s.supersedes),
			superseded_by: to_list(s.superseded_by),
		};
	});
	return new_handlers;
}

// Return true if the supersession graph (edges: A -> B when A supersedes B) is acyclic

function supersedes_is_acyclic(hs) {
	const WHITE = 0, GRAY = 1, BLACK = 2;
	let color = {};
	for (let n in hs)
		color[n] = WHITE;

	function dfs(n) {
		color[n] ??= WHITE;
		if (color[n] == GRAY)
			return false;
		if (color[n] == BLACK)
			return true;
		color[n] = GRAY;
		let h = hs[n];
		if (h) {
			for (let m in h.supersedes) {
				if (!dfs(m))
					return false;
			}
		}
		color[n] = BLACK;
		return true;
	}

	for (let n in hs) {
		if (color[n] == WHITE && !dfs(n))
			return false;
	}
	return true;
}

function cross_check_supersession(hs) {
	// Warn on asymmetric declarations; not fatal.
	for (let a in hs) {
		for (let b in hs[a].supersedes) {
			let hb = hs[b];
			if (!hb) {
				log_warn("handler '%s' supersedes undefined event '%s'", a, b);
				continue;
			}
			let found = false;
			for (let x in hb.superseded_by)
				if (x == a) { found = true; break; }
			if (!found)
				log_warn("asymmetric supersession: '%s' supersedes '%s' but '%s' does not list '%s' in superseded_by",
					 a, b, b, a);
		}
	}
}

// Start a new pending batch for ev.  Called from push_event (idle->pending)
// and from the run-completion callback (pending_after).

function start_pending(name, ev, h, initial_pushes) {
	let now = now_ms();
	ev.batch_start_ms    = now;
	ev.batch_last_push_ms = now;
	ev.batch_pushes      = initial_pushes;
	ev.command_snapshot  = h;
	ev.state             = 'pending';
	ev.window_timer   = uloop.timer(h.window_ms,     function () { fire_handler(name, false); });
	ev.deadline_timer = uloop.timer(h.max_window_ms, function () { fire_handler(name, true);  });
}

fire_handler = function (name, from_deadline) {
	let ev = events[name];
	if (!ev || ev.state != 'pending') {
		// Spurious; can happen if timer fires after cancellation.
		return;
	}
	let snap = ev.command_snapshot;
	if (!snap) {
		log_err("fire for '%s' with no snapshot; resetting to idle", name);
		cancel_coalescing_timers(ev);
		ev.state = 'idle';
		return;
	}

	// Record timing for this batch before clearing batch state.
	let now = now_ms();
	if (from_deadline)
		ev.counters.deadline_fires++;
	ev.last_fired_at_ms      = now;
	ev.last_batch_duration_ms = now - ev.batch_start_ms;
	ev.last_batch_pushes     = ev.batch_pushes;
	ev.batch_pushes          = 0;

	cancel_coalescing_timers(ev);
	ev.state = 'running';
	ev.counters.invocations++;

	let wrapped = "eval \"$EVTD_CMD\" 2>&1 | " +
		"logger -t \"mwan3evtd[" + name + "]\" -p daemon.info";

	let env = {
		EVTD_CMD: snap.command,
		PATH: '/usr/sbin:/usr/bin:/sbin:/bin',
		HOME: '/root',
		TERM: 'dumb',
	};

	log_info("firing handler for '%s'", name);

	let proc = uloop.process('/usr/bin/setsid',
		[ '/bin/sh', '-c', wrapped ],
		env,
		function (exitcode) {
			clear_handler_timers(ev);
			delete ev.handler_proc;
			delete ev.handler_pid;
			if (exitcode != 0) {
				ev.counters.failures++;
				log_warn("handler '%s' exited with %d", name, exitcode);
			}
			// Run-state exit: honour pending-after if set.
			if (ev.pending_after) {
				ev.pending_after = false;
				let h = handlers[name];
				if (h) {
					// pending_after_pushes holds the count of pushes that
					// arrived while the handler was running.
					start_pending(name, ev, h, ev.pending_after_pushes);
					ev.pending_after_pushes = 0;
				} else {
					// Handler removed while running; drop.
					delete ev.command_snapshot;
					ev.state = 'idle';
				}
			} else {
				delete ev.command_snapshot;
				ev.state = 'idle';
			}
		}
	);

	if (!proc) {
		log_err("failed to spawn handler for '%s'", name);
		ev.counters.failures++;
		delete ev.command_snapshot;
		ev.state = 'idle';
		// Honour pending-after even on spawn failure.
		if (ev.pending_after) {
			ev.pending_after = false;
			let h = handlers[name];
			if (h) {
				start_pending(name, ev, h, ev.pending_after_pushes);
				ev.pending_after_pushes = 0;
			}
		}
		return;
	}

	ev.handler_proc = proc;
	ev.handler_pid = proc.pid();
	let pid = ev.handler_pid;

	ev.handler_timeout_timer = uloop.timer(snap.handler_timeout_ms, function () {
		if (ev.state != 'running')
			return;
		ev.counters.timeouts++;
		log_warn("handler '%s' timed out after %d ms; SIGTERM pgid %d",
			name, snap.handler_timeout_ms, pid);
		system([ '/bin/kill', '-TERM', '-' + pid ], KILL_CMD_TIMEOUT_MS);
		ev.handler_kill_timer = uloop.timer(SIGKILL_DELAY_MS, function () {
			if (ev.state != 'running')
				return;
			log_warn("handler '%s' still running after SIGTERM; SIGKILL pgid %d", name, pid);
			system([ '/bin/kill', '-KILL', '-' + pid ], KILL_CMD_TIMEOUT_MS);
		});
	});
};

function push_event(name, caller) {
	let h = handlers[name];
	let ct = caller ? " [" + caller + "]" : "";
	if (!h) {
		log_warn("push for unknown event '%s'%s", name, ct);
		return { ok: false, reason: 'unknown event' };
	}

	let ev = ensure_event(name);

	// Supersession: if a stronger event is currently pending, discard this push.
	for (let s in h.superseded_by) {
		let other = events[s];
		if (other && other.state == 'pending') {
			ev.counters.superseded_as_source++;
			log_info("push '%s'%s discarded: superseded by pending '%s'", name, ct, s);
			return { ok: true, accepted: false, reason: 'superseded_by:' + s };
		}
	}

	// Supersession: cancel pending timers for weaker events.
	for (let s in h.supersedes) {
		let other = events[s];
		if (other && other.state == 'pending') {
			cancel_coalescing_timers(other);
			delete other.command_snapshot;
			other.state = 'idle';
			other.counters.superseded_as_target++;
			log_info("push '%s' cancelled pending '%s' via supersession", name, s);
		}
	}

	ev.counters.pushes++;

	if (ev.state == 'idle') {
		log_info("push '%s'%s: new batch pending", name, ct);
		start_pending(name, ev, h, 1);
	}
	else if (ev.state == 'pending') {
		// Reset only the trailing-debounce window.  Keep the deadline and snapshot.
		let now = now_ms();
		let gap = now - ev.batch_last_push_ms;
		if (gap > ev.counters.max_inter_push_ms)
			ev.counters.max_inter_push_ms = gap;
		ev.batch_last_push_ms = now;
		ev.batch_pushes++;
		ev.counters.window_resets++;
		if (ev.window_timer) ev.window_timer.cancel();
		ev.window_timer = uloop.timer(h.window_ms, function () { fire_handler(name, false); });
	}
	else if (ev.state == 'running') {
		ev.pending_after = true;
		ev.pending_after_pushes++;
		ev.counters.after_running_coalesced++;
	}

	return { ok: true, accepted: true };
}

function reconcile_removed(old_h, new_h) {
	for (let name in old_h) {
		if (new_h[name])
			continue;
		let ev = events[name];
		if (ev && ev.state == 'pending') {
			cancel_coalescing_timers(ev);
			delete ev.command_snapshot;
			ev.state = 'idle';
			log_info("handler '%s' removed from config; cancelled pending timer", name);
		}
		// Running handlers complete with their original snapshot.
	}
}

function do_reload() {
	let new_h = load_config();
	if (!supersedes_is_acyclic(new_h)) {
		log_err("reload: supersession cycle detected; keeping previous config");
		return { ok: false, reason: 'cycle' };
	}
	cross_check_supersession(new_h);
	let old_h = handlers;
	handlers = new_h;
	reconcile_removed(old_h, new_h);
	log_info("config reloaded: %d handler(s)", length(handlers));
	return { ok: true, count: length(handlers) };
}

function render_handler(name) {
	let h = handlers[name];
	let ev = events[name];
	let out = {
		event: name,
		command: h.command,
		window_ms: h.window_ms,
		max_window_ms: h.max_window_ms,
		handler_timeout_ms: h.handler_timeout_ms,
		supersedes: h.supersedes,
		superseded_by: h.superseded_by,
		state: ev ? ev.state : 'idle',
	};
	if (ev && ev.state == 'pending') {
		if (ev.window_timer)   out.window_remaining_ms   = ev.window_timer.remaining();
		if (ev.deadline_timer) out.deadline_remaining_ms = ev.deadline_timer.remaining();
	}
	if (ev && ev.state == 'running') {
		out.handler_pid = ev.handler_pid;
		if (ev.handler_timeout_timer)
			out.timeout_remaining_ms = ev.handler_timeout_timer.remaining();
		out.pending_after = ev.pending_after;
	}
	return out;
}

// -- main ---------------------------------------------------------------

uloop.init();

let ubus = libubus.connect();
if (!ubus) {
	log_err("failed to connect to ubus");
	exit(1);
}

handlers = load_config();
if (!supersedes_is_acyclic(handlers)) {
	log_err("supersession cycle in initial config; refusing to start");
	exit(1);
}
cross_check_supersession(handlers);
log_info("started; %d handler(s) configured", length(handlers));

let obj = ubus.publish('mwan3evtd', {
	push: {
		args: { event: '', caller: '' },
		call: function (req) {

			// req.args is null-propagated safely in ucode when args are absent;
			// the type check below catches both null and wrong types.

			if (type(req.args.event) != 'string' || !match(req.args.event, EVENT_NAME_RE))
				return libubus.STATUS_INVALID_ARGUMENT;

			// Event names reaching push_event are regex-validated here, so
			// interpolating them into the logger tag in fire_handler is safe.

			let caller = (type(req.args.caller) == 'string' && length(req.args.caller) > 0)
				? req.args.caller : null;
			return push_event(req.args.event, caller);
		},
	},

	list: {
		args: {},
		call: function (req) {
			let ret = [];
			for (let name in handlers)
				push(ret, render_handler(name));
			return { handlers: ret };
		},
	},

	status: {
		args: {},
		call: function (req) {
			let ret = [];
			for (let name in handlers) {
				let ev = events[name];
				let zero_counters = {
					pushes: 0, invocations: 0,
					superseded_as_source: 0, superseded_as_target: 0,
					after_running_coalesced: 0, failures: 0, timeouts: 0,
					window_resets: 0, deadline_fires: 0, max_inter_push_ms: 0,
				};
				push(ret, {
					event:                  name,
					state:                  ev ? ev.state                  : 'idle',
					last_fired_at_ms:       ev ? ev.last_fired_at_ms       : 0,
					last_batch_duration_ms: ev ? ev.last_batch_duration_ms : 0,
					last_batch_pushes:      ev ? ev.last_batch_pushes      : 0,
					counters:               ev ? ev.counters               : zero_counters,
				});
			}
			return { events: ret };
		},
	},

	flush: {
		args: { event: '' },
		call: function (req) {
			// Same null-propagation and injection-safety guarantees as push above.
			if (type(req.args.event) != 'string' || !match(req.args.event, EVENT_NAME_RE))
				return libubus.STATUS_INVALID_ARGUMENT;
			let name = req.args.event;
			let ev = events[name];
			if (!ev || ev.state != 'pending')
				return { fired: false, reason: ev ? ev.state : 'no-event' };
			fire_handler(name, false);
			return { fired: true };
		},
	},

	reload: {
		args: {},
		call: function (req) {
			let r = do_reload();
			if (!r.ok)
				return libubus.STATUS_INVALID_ARGUMENT;
			return { reloaded: true, count: r.count };
		},
	},

	reset: {
		args: {},
		call: function (req) {
			let n = 0;
			for (let name in handlers) {
				let ev = events[name];
				if (!ev)
					continue;
				ev.last_fired_at_ms                 = 0;
				ev.last_batch_duration_ms           = 0;
				ev.last_batch_pushes                = 0;
				ev.counters.pushes                  = 0;
				ev.counters.invocations             = 0;
				ev.counters.superseded_as_source    = 0;
				ev.counters.superseded_as_target    = 0;
				ev.counters.after_running_coalesced = 0;
				ev.counters.failures                = 0;
				ev.counters.timeouts                = 0;
				ev.counters.window_resets           = 0;
				ev.counters.deadline_fires          = 0;
				ev.counters.max_inter_push_ms       = 0;
				n++;
			}
			log_info("counters reset (%d event(s))", n);
			return { ok: true, reset: n };
		},
	},
});

if (!obj) {
	log_err("failed to publish ubus object 'mwan3evtd'");
	exit(1);
}

// Reload config on SIGHUP
signal('SIGHUP', function () {
	log_info("SIGHUP received; reloading config");
	do_reload();
});

uloop.run();
