# Event handler registrations for mwan3evtd.
#
# Each `config handler` declares one named event.  Callers push the
# event via `ubus call mwan3evtd push '{"event":"<name>"}'` or the
# `mwan3evtd-push <name>` wrapper.  mwan3evtd coalesces pushes within `window_ms`
# (reset per push, trailing debounce) bounded by `max_window_ms`
# (deadline from first push).  When the window closes, `command` is
# executed at most once.  `handler_timeout_ms` bounds handler runtime.
#
# Supersession: if A declares `list supersedes 'B'`, an incoming A push
# cancels any pending B timer.  B should pair this with `list
# superseded_by 'A'` so a B push arriving while A is pending is
# discarded.  Supersession operates only on pending timers, never on
# in-flight handlers.

config handler
	option event 'dnsmasq-hup'
	option command "ubus call service signal '{\"name\":\"dnsmasq\",\"signal\":1}'"
	option window_ms '5000'
	option max_window_ms '30000'
	option handler_timeout_ms '10000'
	list superseded_by 'dnsmasq-restart'

config handler
	option event 'dnsmasq-restart'
	option command '/etc/init.d/dnsmasq restart'
	option window_ms '5000'
	option max_window_ms '10000'
	option handler_timeout_ms '30000'
	list supersedes 'dnsmasq-hup'

